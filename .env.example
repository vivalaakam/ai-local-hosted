# Скопируйте в .env. Сервер читает этот файл и не перезаписывает уже заданные переменные.
# Вход в API — учётка пользователя (POST /oauth/register и /oauth/token), не переменная окружения.
DATABASE_URL=postgres://local_user:local_password@localhost:15432/ai-local-hosted
BIND=127.0.0.1:8080
OLLAMA_BASE_URL=http://127.0.0.1:11434
# PROVIDER_TIMEOUT_MS=60000
# STREAM_IDLE_MS=120000
